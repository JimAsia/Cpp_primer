// ============================================================================
//  launch.json —— F5 调试配置（cppdbg + gdb 18.1）
//  按 F5 时会先跑 preLaunchTask 编译，再由 gdb 启动 .build 里的 exe
//
//  这里为什么参数这么啰嗦？因为三处路径必须完全对应：
//      build.ps1  : -OutDir "${workspaceFolder}\.build" + 产物名 = <源文件名>.exe
//      launch.json: "program": "${workspaceFolder}\.build\${fileBasenameNoExtension}.exe"
//  改其中一处命名规则，另一处必须同步改，否则 F5 会报“找不到程序”。
// ============================================================================
{
  // 固定写法，别改（VS Code 调试配置的 schema 版本）
  "version": "0.2.0",
  "configurations": [
    {
      // 出现在 F5 时左上角的下拉列表里
      "name": "C++: 调试当前文件 (gdb)",
      // cppdbg = 用 C/C++ 扩展自带的调试适配器（OpenDebugAD7）去驱动 gdb
      "type": "cppdbg",
      // launch = 启动一个新进程来调试（attach 则是附加到已有进程）
      "request": "launch",

      // 要调试的 exe。${fileBasenameNoExtension} = 当前编辑器文件名（不带扩展名），
      // 所以对 main.cpp 按 F5 时调试的就是 .build\main.exe
      "program": "${workspaceFolder}\\.build\\${fileBasenameNoExtension}.exe",

      // 传给程序的命令行参数，例如 ["input.txt", "3"]。
      // 用 ${workspaceFolder} 或 ${fileDirname} 可以写相对/绝对路径。
      "args": [],

      // false = 直接跑到你打的断点；
      // true  = 进 main 第一行就停（下面第二个配置就是这么设的）
      "stopAtEntry": false,

      // 程序运行时的当前目录。设成源文件所在目录，
      // 这样代码里相对路径读文件时会去源文件旁边找。
      "cwd": "${fileDirname}",

      // 给被调试程序注入环境变量。必须把 ucrt64\bin 加进 PATH，
      // 否则 exe 运行时找不到 libstdc++-6.dll / libgcc_s_seh-1.dll，
      // 会以 0xC0000135（缺 DLL）直接退出。
      // ${env:PATH} 是“在你原有 PATH 前面追加”，不是覆盖。
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],

      // false = 用 VS Code 内置终端显示程序输出（调试面板里就能看）；
      // true  = 弹一个独立控制台窗口，stdin 输入体验更接近普通运行。
      // 如果调试的程序要大量手敲输入，可以改成 true 试试。
      "externalConsole": false,

      // 使用 gdb 作为底层调试器（另一个可选值是 vsdbg / lldb）
      "MIMode": "gdb",

      // gdb 可执行文件路径（已确认存在：GDB 18.1）。
      // 换 gdb 位置时只改这一行。
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",

      // 启动调试会话后发给 gdb 的初始化命令
      "setupCommands": [
        {
          // description 只是给自己看的说明，会显示在调试控制台日志里
          "description": "启用 STL 容器/智能指针的整齐打印",
          // 让 vector/string/map 等按内容显示，而不是显示裸指针。
          // 实测效果：std::vector of length 5, capacity 5 = {"...", "..."}
          "text": "-enable-pretty-printing",
          // true = 万一这条命令失败也不中断调试（更耐折腾）
          "ignoreFailures": true
        }
      ],

      // ★ 关键：按 F5 前先执行这个任务（名字必须与 tasks.json 里的 label 完全一致）。
      // 好处是编译失败时 F5 会直接报错，不会去调试上一次的旧程序。
      // 想“只调试、不重新编译”，把这个字段删掉即可 —— 第三个配置就是这么做的。
      "preLaunchTask": "C++: 编译当前文件",

      // 编译（preLaunchTask）最多等 30 秒，超时按失败处理，
      // 避免卡住时 VS Code 一直显示“正在构建”不动。
      "timeout": 30000
    },

    {
      // 与第一个配置完全相同，只差 stopAtEntry = true：
      // 不用提前打断点，F5 后直接停在 main 的第一行
      "name": "C++: 调试当前文件 (进 main 就停)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\.build\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${fileDirname}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "启用 STL 容器/智能指针的整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C++: 编译当前文件",
      "timeout": 30000
    },

    {
      // 这个配置【故意没有 preLaunchTask】：
      // 直接调试 .build 里现成的 exe，不重新编译。
      // 适合：程序已经编译好了、只想反复调试，或者想调试一个 Release 版。
      // 代价：忘了先编译时，调试的是旧程序（变量值与源码对不上）。
      "name": "C++: 调试已编译好的 exe (不重新编译)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\.build\\${fileBasenameNoExtension}.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "启用 STL 容器/智能指针的整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "timeout": 30000
    }
  ]
}
