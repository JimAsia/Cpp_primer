{
    // ================================================================
    //  构建任务：Ctrl+Shift+B 执行默认任务 "g++: 编译全部源文件"
    //  · 默认任务不依赖 CMake，只要能找到 g++ 就能编译
    //  · 新增 .cpp 后：要么在下面显式列表里补一行，要么改用通配符版本任务
    //  · 编译器路径按你自己的环境改（当前是 C:/Users/admin/mingw64/bin/g++.exe）
    // ================================================================
    "version": "2.0.0",

    "tasks": [
        {
            // ---------- 1) 纯 g++：显式列出所有源文件（最稳，默认任务） ----------
            "label": "g++: 编译全部源文件",
            "type": "cppbuild",
            "command": "C:/Users/admin/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",                                  // 调试信息，F5 断点必需
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/include",        // 头文件目录
                "${workspaceFolder}/src/main.cpp",     // 有且只有一个 main
                "${workspaceFolder}/src/math_utils.cpp",
                "${workspaceFolder}/src/greeter.cpp",
                "-o",
                "${workspaceFolder}/build/demo.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },

        {
            // ---------- 2) 纯 g++：通配符版本（新增源文件不用改配置） ----------
            // 依赖 g++ 自身的通配符展开（Windows 的 cmd/PowerShell 不会展开 *）。
            // 若报错 "No such file or directory: .../src/*.cpp"，就改用任务 1。
            "label": "g++: 编译全部源文件（通配符）",
            "type": "cppbuild",
            "command": "C:/Users/admin/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/build/demo.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },

        {
            // ---------- 3) CMake：配置（生成 Makefile / 工程文件） ----------
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug"
                // 如果报错"找不到合适的生成器 / Generator not found"，
                // 说明没装 Visual Studio，请把上面这行改成：
                // "-DCMAKE_BUILD_TYPE=Debug", "-G", "MinGW Makefiles"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },

        {
            // ---------- 4) CMake：构建 ----------
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "Debug",
                "--parallel"
            ],
            "dependsOn": ["cmake: configure"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },

        {
            // ---------- 5) 纯 g++：只编译当前打开的这一个文件（单文件练习用） ----------
            // ${file} = 当前活动文件，${fileDirname} = 它所在目录
            // 产物与源文件同目录同名：test.cpp -> test.exe（不写进 build/）
            // 注意：不要拿它编译本工程的 src/main.cpp —— 单独编译会在链接期报
            //       undefined reference to demo::add(...)，那些函数在别的 .cpp 里
            "label": "g++: 编译当前文件（单文件）",
            "type": "cppbuild",
            "command": "C:/Users/admin/mingw64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
