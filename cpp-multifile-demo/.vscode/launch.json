{
    "version": "0.2.0",

    "configurations": [
        {
            // ---------- 用 g++ 任务构建出来的程序（F5 默认用这个） ----------
            "name": "调试 demo（g++ 构建）",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build/demo.exe",
            // 必须和 tasks.json 里 g++ 任务的 -o 输出路径一致

            "args": ["VSCode"],
            // 传给 main 的命令行参数，等价于 ./demo.exe VSCode
            // 不需要就写成 []

            "stopAtEntry": false,
            // true = 启动就停在 main 第一行；false = 只停在你自己打的断点

            "cwd": "${workspaceFolder}",
            // 程序运行的工作目录，影响相对路径的文件读写

            "environment": [],
            "externalConsole": false,
            // false = 输出在 VS Code 内置终端；需要键盘输入时改成 true 更稳

            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/admin/mingw64/bin/gdb.exe",
            // GDB 路径，按自己环境改

            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],

            "preLaunchTask": "g++: 编译全部源文件"
            // 按 F5 前自动执行的编译任务，名字必须和 tasks.json 的 label 完全一致
        },

        {
            // ---------- 用 CMake 构建出来的程序 ----------
            // 注意：如果 CMake 用的是 Visual Studio 生成器，产物在
            //       build/Debug/demo.exe，请自行把下面的 program 改掉
            "name": "调试 demo（CMake 构建）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/demo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/admin/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build"
        },

        {
            // ---------- 只调试「当前打开的那一个单文件」 ----------
            // 程序路径跟着活动文件走：1_3.cpp -> 同目录下的 1_3.exe
            // 想把单文件设为按 F5 的默认行为，就把这一整段移到 configurations 数组第一位
            "name": "调试当前文件（单文件）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/admin/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "g++: 编译当前文件（单文件）"
        }
    ]
}
