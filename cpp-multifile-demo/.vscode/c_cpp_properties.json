{
    // 只影响 IntelliSense（代码补全 / 波浪线），不影响真正的编译
    "version": 4,
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            // 改成你本机 g++.exe 的真实路径；换电脑/换 MSYS2 时这条最容易忘
            "compilerPath": "C:/Users/admin/mingw64/bin/g++.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ]
}
